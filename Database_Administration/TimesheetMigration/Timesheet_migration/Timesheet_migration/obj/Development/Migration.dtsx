    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{A017232A-B9E8-4A53-A778-022FD10EE4FF}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="SUBSTRING(&#xA;@[User::FileName],&#xA;FINDSTRING(@[User::FileName], &quot;_&quot;, 2) + 1,&#xA;FINDSTRING(@[User::FileName], &quot;_&quot;, 3)&#xA;- FINDSTRING(@[User::FileName], &quot;_&quot;, 2) - 1&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Month">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D76F0637-AA16-40A1-AB5D-CB3BB1DB9134}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="SUBSTRING(TRIM(@[User::Month]),1,3) + &quot;$&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Sheet">
      <DTS:VariableValue
        DTS:DataType="8">$</DTS:VariableValue>
    </DTS:Variable>
