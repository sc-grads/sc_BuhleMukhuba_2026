              SQLTask:SqlStatementSource="INSERT INTO EmployeeLeave&#xA;(&#xA;    EmployeeID,&#xA;    LeaveTypeID,&#xA;    LeaveDate,&#xA;    HoursTaken,&#xA;    SourceFileName&#xA;)&#xA;SELECT&#xA;    e.EmployeeID,&#xA;    l.LeaveTypeID,&#xA;    s.WorkDate,&#xA;    s.HoursWorked,&#xA;    s.SourceFileName&#xA;FROM Stg_Timesheet s&#xA;JOIN Employee e&#xA;    ON e.FirstName = s.FirstName&#xA;   AND e.LastName = s.LastName&#xA;JOIN LeaveType l&#xA;    ON UPPER(LTRIM(RTRIM(s.ActivityName))) =&#xA;       UPPER(LTRIM(RTRIM(l.LeaveType)))&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM EmployeeLeave el&#xA;    WHERE el.EmployeeID = e.EmployeeID&#xA;      AND el.LeaveDate = s.WorkDate&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
