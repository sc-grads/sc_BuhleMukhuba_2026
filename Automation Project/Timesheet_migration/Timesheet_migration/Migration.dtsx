              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;/* =========================&#xA;   DROP PROD + STAGING TABLES&#xA;========================= */&#xA;&#xA;IF OBJECT_ID('dbo.EmployeeLeave', 'U') IS NOT NULL&#xA;    DROP TABLE dbo.EmployeeLeave;&#xA;&#xA;IF OBJECT_ID('dbo.Timesheet', 'U') IS NOT NULL&#xA;    DROP TABLE dbo.Timesheet;&#xA;&#xA;IF OBJECT_ID('dbo.Employee', 'U') IS NOT NULL&#xA;    DROP TABLE dbo.Employee;&#xA;&#xA;IF OBJECT_ID('dbo.Stg_Timesheet', 'U') IS NOT NULL&#xA;    DROP TABLE dbo.Stg_Timesheet;&#xA;&#xA;&#xA;/* =========================&#xA;   LOOKUP TABLES (ENSURE EXIST)&#xA;========================= */&#xA;&#xA;IF OBJECT_ID('dbo.Activity', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE Activity (&#xA;        ActivityID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ActivityName VARCHAR(100) NOT NULL UNIQUE&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('dbo.Client', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE Client (&#xA;        ClientID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ClientName VARCHAR(150) NOT NULL UNIQUE,&#xA;        ClientProject VARCHAR(150),&#xA;        CreatedDate DATETIME NOT NULL DEFAULT GETDATE()&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('dbo.LeaveType', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE LeaveType (&#xA;        LeaveTypeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        LeaveType VARCHAR(100) NOT NULL UNIQUE&#xA;    );&#xA;END;&#xA;&#xA;&#xA;/* =========================&#xA;   RECREATE STAGING TABLE&#xA;========================= */&#xA;&#xA;CREATE TABLE Stg_Timesheet (&#xA;    FirstName VARCHAR(50),&#xA;    LastName VARCHAR(50),&#xA;    ActivityName VARCHAR(100),&#xA;    ClientName VARCHAR(150),&#xA;    ClientProject VARCHAR(150),&#xA;    WorkDay VARCHAR(50),&#xA;    WorkDate DATE,&#xA;    Comments VARCHAR(MAX),&#xA;    HoursWorked TIME,&#xA;    StartTime TIME,&#xA;    EndTime TIME,&#xA;    Billing VARCHAR(50),&#xA;    SourceFileName VARCHAR(255)&#xA;);&#xA;&#xA;&#xA;/* =========================&#xA;   RECREATE EMPLOYEE&#xA;========================= */&#xA;&#xA;CREATE TABLE Employee (&#xA;    EmployeeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    FirstName VARCHAR(100) NOT NULL,&#xA;    LastName VARCHAR(100) NOT NULL,&#xA;    CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;    CONSTRAINT UQ_Employee UNIQUE (FirstName, LastName)&#xA;);&#xA;&#xA;&#xA;/* =========================&#xA;   RECREATE TIMESHEET&#xA;========================= */&#xA;&#xA;CREATE TABLE Timesheet (&#xA;    TimesheetID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    TimesheetCode VARCHAR(20),&#xA;    EmployeeID INT NOT NULL,&#xA;    ActivityID INT NOT NULL,&#xA;    ClientID INT NOT NULL,&#xA;    WorkDate DATE NOT NULL,&#xA;    Comments VARCHAR(MAX),&#xA;    HoursWorked NVARCHAR(5) NOT NULL,&#xA;    StartTime NVARCHAR(5) NOT NULL,&#xA;    EndTime NVARCHAR(5),&#xA;    Billing VARCHAR(50),&#xA;    SourceFileName VARCHAR(255) NOT NULL,&#xA;    CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;&#xA;    CONSTRAINT FK_Timesheet_Employee&#xA;        FOREIGN KEY (EmployeeID) REFERENCES Employee(EmployeeID),&#xA;&#xA;    CONSTRAINT FK_Timesheet_Activity&#xA;        FOREIGN KEY (ActivityID) REFERENCES Activity(ActivityID),&#xA;&#xA;    CONSTRAINT FK_Timesheet_Client&#xA;        FOREIGN KEY (ClientID) REFERENCES Client(ClientID)&#xA;);&#xA;&#xA;&#xA;/* =========================&#xA;   RECREATE EMPLOYEE LEAVE&#xA;========================= */&#xA;&#xA;CREATE TABLE EmployeeLeave (&#xA;    LeaveID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    EmployeeID INT NOT NULL,&#xA;    LeaveTypeID INT NOT NULL,&#xA;    LeaveDate DATE NOT NULL,&#xA;    HoursTaken NVARCHAR(5) NOT NULL,&#xA;    SourceFileName VARCHAR(255),&#xA;    CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;&#xA;    CONSTRAINT FK_EmployeeLeave_Employee&#xA;        FOREIGN KEY (EmployeeID) REFERENCES Employee(EmployeeID),&#xA;&#xA;    CONSTRAINT FK_EmployeeLeave_LeaveType&#xA;        FOREIGN KEY (LeaveTypeID) REFERENCES LeaveType(LeaveTypeID),&#xA;&#xA;    CONSTRAINT UQ_Leave UNIQUE (EmployeeID, LeaveDate)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
=======
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;&#xA;CREATE TABLE Employee (&#xA;    EmployeeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    FirstName VARCHAR(100) NOT NULL,&#xA;    LastName VARCHAR(100) NOT NULL,&#xA;    CreatedDate DATE NOT NULL DEFAULT GETDATE()&#xA;);&#xA;&#xA;ALTER TABLE Employee&#xA;ADD CONSTRAINT UQ_Employee_Name UNIQUE (FirstName, LastName);&#xA;&#xA;CREATE INDEX IX_Employee_Name&#xA;ON Employee(FirstName, LastName);&#xA;&#xA;-- ACTIVITY TABLE&#xA;CREATE TABLE Activity (&#xA;    ActivityID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    ActivityName VARCHAR(100) NOT NULL&#xA;);&#xA;&#xA;ALTER TABLE Activity&#xA;ADD CONSTRAINT UQ_ActivityName UNIQUE (ActivityName);&#xA;&#xA;CREATE INDEX IX_ActivityName&#xA;ON Activity(ActivityName);&#xA;&#xA;-- CLIENT TABLE&#xA;CREATE TABLE Client (&#xA;    ClientID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    ClientName VARCHAR(150) NOT NULL,&#xA;    ClientProject VARCHAR(150),&#xA;    CreatedDate DATE NOT NULL DEFAULT GETDATE()&#xA;);&#xA;&#xA;ALTER TABLE Client&#xA;ADD CONSTRAINT UQ_ClientName UNIQUE (ClientName);&#xA;&#xA;CREATE INDEX IX_ClientName&#xA;ON Client(ClientName);&#xA;&#xA;-- TIMESHEET TABLE&#xA;CREATE TABLE Timesheet (&#xA;    TimesheetID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    TimesheetCode VARCHAR(20) NOT NULL,&#xA;    EmployeeID INT NOT NULL,&#xA;    ActivityID INT NOT NULL,&#xA;    ClientID INT NOT NULL,&#xA;    ClientProject VARCHAR(150),&#xA;    WorkDate DATE NOT NULL,&#xA;    HoursWorked TIME NOT NULL,&#xA;    StartTime TIME NOT NULL,&#xA;    EndTime Time NOT NULL,&#xA;    Billing VARCHAR(50) NOT NULL,&#xA;    SourceFileName VARCHAR(255) NOT NULL,&#xA;    CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;&#xA;    CONSTRAINT FK_Timesheet_Employee&#xA;        FOREIGN KEY (EmployeeID) REFERENCES Employee(EmployeeID),&#xA;&#xA;    CONSTRAINT FK_Timesheet_Activity&#xA;        FOREIGN KEY (ActivityID) REFERENCES Activity(ActivityID),&#xA;&#xA;    CONSTRAINT FK_Timesheet_Client&#xA;        FOREIGN KEY (ClientID) REFERENCES Client(ClientID)&#xA;);&#xA;&#xA;CREATE INDEX IX_Timesheet_EmployeeID ON Timesheet(EmployeeID);&#xA;CREATE INDEX IX_Timesheet_ActivityID ON Timesheet(ActivityID);&#xA;CREATE INDEX IX_Timesheet_ClientID ON Timesheet(ClientID);&#xA;CREATE INDEX IX_Timesheet_WorkDate ON Timesheet(WorkDate);&#xA;&#xA;--Leave &#xA;&#xA;CREATE TABLE LeaveType (&#xA;    LeaveTypeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    LeaveType VARCHAR(100) NOT NULL UNIQUE&#xA;);&#xA;&#xA;CREATE TABLE EmployeeLeave (&#xA;LeaveID INT IDENTITY(1,1) PRIMARY KEY,&#xA;EmployeeID INT NOT NULL,&#xA;LeaveTypeID INT NOT NULL,&#xA;LeaveDate DATE NOT NULL,&#xA;HoursTaken TIME NOT NULL,&#xA;SourceFileName VARCHAR(255) NULL,&#xA;CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;&#xA;CONSTRAINT FK_EmployeeLeave_Employee&#xA;    FOREIGN KEY (EmployeeID)&#xA;    REFERENCES Employee(EmployeeID),&#xA;&#xA;CONSTRAINT FK_EmployeeLeave_LeaveType&#xA;    FOREIGN KEY (LeaveTypeID)&#xA;    REFERENCES LeaveType(LeaveTypeID)&#xA;&#xA;);&#xA;&#xA;ALTER TABLE EmployeeLeave&#xA;ADD CONSTRAINT UQ_Leave UNIQUE (EmployeeID, LeaveDate);&#xA;&#xA;CREATE UNIQUE INDEX IX_LeaveType&#xA;ON LeaveType(LeaveType);&#xA;&#xA;CREATE INDEX IX_EmployeeLeave_EmployeeID&#xA;ON EmployeeLeave(EmployeeID);&#xA;&#xA;CREATE INDEX IX_EmployeeLeave_LeaveTypeID&#xA;ON EmployeeLeave(LeaveTypeID);&#xA;&#xA;CREATE INDEX IX_EmployeeLeave_LeaveDate&#xA;ON EmployeeLeave(LeaveDate);&#xA;&#xA;CREATE INDEX IX_EmployeeLeave_EmployeeDate&#xA;ON EmployeeLeave(EmployeeID, LeaveDate);&#xA;&#xA;CREATE INDEX IX_EmployeeLeave_EmployeeLeaveType&#xA;ON EmployeeLeave(EmployeeID, LeaveTypeID);&#xA;&#xA;CREATE INDEX IX_EmployeeLeave_SourceFile&#xA;ON EmployeeLeave(SourceFileName);&#xA;&#xA;-- STAGING TABLE&#xA;CREATE TABLE Stg_Timesheet (&#xA;    FirstName VARCHAR(50),&#xA;    LastName VARCHAR(50),&#xA;    ActivityName VARCHAR(100),&#xA;    ClientName VARCHAR(150),&#xA;    ClientProject VARCHAR(150),&#xA;    WorkDay VARCHAR(50),&#xA;    WorkDate DATE,&#xA;    HoursWorked TIME,&#xA;    StartTime TIME,&#xA;    EndTime Time,&#xA;    Billing VARCHAR(50),&#xA;    SourceFileName VARCHAR(255)&#xA;);&#xA;&#xA;-- AUDIT TABLE&#xA;CREATE TABLE AuditLog (&#xA;    AuditID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    PackageName VARCHAR(255) NOT NULL,&#xA;    FileName VARCHAR(255),&#xA;    Status VARCHAR(50) NOT NULL,&#xA;    StartTime DATETIME NOT NULL DEFAULT GETDATE(),&#xA;    EndTime DATETIME  NOT NULL DEFAULT GETDATE(),&#xA;    ErrorMessage VARCHAR(MAX)&#xA;);&#xA;&#xA;CREATE INDEX IX_Audit_Status ON AuditLog(Status);&#xA;CREATE INDEX IX_Audit_File ON AuditLog(FileName);&#xA;&#xA;-- SEED DATA (unchanged)&#xA;INSERT INTO Activity (ActivityName)&#xA;VALUES&#xA;('.NET code'), ('Admin'), ('Analysis'), ('Architecture'), ('Training'),&#xA;('Configuration'), ('Cubes'), ('Database'), ('Demo'), ('Deployment'),&#xA;('Design'), ('Documentation'), ('Events'), ('ETL'), ('FrontEnd'),&#xA;('Installing'), ('Meeting'), ('Learning'), ('Lunch'), ('Other'), ('Presenting'),&#xA;('Project Management'), ('Research'), ('Sales call'), ('SharePoint'),&#xA;('Testing'), ('Travel'), ('Troubleshooting'), ('Waiting on client'),&#xA;('Website content'), ('Website and collateral'), ('Annual Leave'),&#xA;('Sick leave'), ('Study Leave'), ('Family Responsibility Leave'),&#xA;('Birthday leave'), ('Public Holiday'), ('Sick Leave - half day'),&#xA;('Annual Leave - half day');&#xA;&#xA;INSERT INTO Client (ClientName)&#xA;VALUES&#xA;('Internal Sambe'), ('ADVTech'), ('AFA Sasfin'), ('Artist Proof Studio'),&#xA;('Assimil8'), ('Base 3'), ('Blue Legacy'), ('C. Steinweg'),&#xA;('Conekt – Aurum'), ('Conekt – Clientele'), ('Conekt – Internal Meeting'),&#xA;('Conekt – Meridian'), ('Conekt – Winning Business'),&#xA;('Conekt AGSA SharePoint'), ('Dentons'), ('Discovery'),&#xA;('Discovery Bank'), ('Discovery CRES'), ('Discovery CSI'),&#xA;('Discovery Health'), ('Discovery Information Governance and Security'),&#xA;('Discovery Innovation Lab'), ('Discovery People'), ('Discovery Skills'),&#xA;('Discovery Vitality'), ('Gyro'), ('KFC Digistics'), ('Life Healthcare'),&#xA;('Medi-Charge'), ('MICA Build'), ('Michelin'), ('Mistro Foods'),&#xA;('OK Furnitures'), ('Olympic Paints'), ('RMB'),&#xA;('RMB CM Data Warehouse support'), ('RMB CORE NRTI'), ('RMB Tumelo'),&#xA;('Sachar Mobile'), ('Sanlam'), ('SBV'), ('Sibanya'), ('Transport Holdings');&#xA;&#xA;INSERT INTO LeaveType (LeaveType)&#xA;VALUES&#xA; ('Annual Leave'),('Sick leave'), ('Study Leave'), ('Family Responsibility Leave'),&#xA;('Birthday leave'), ('Public Holiday'), ('Sick Leave - half day'),&#xA;('Annual Leave - half day');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
