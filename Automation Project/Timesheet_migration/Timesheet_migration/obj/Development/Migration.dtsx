  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E6CC3BDC-70A4-44A4-ABE7-C83BE6534CD5}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="REVERSE(&#xA;    LEFT(REVERSE(@[User::FilePath]),&#xA;        FINDSTRING(REVERSE(@[User::FilePath]), &quot;\\&quot;, 1) - 1&#xA;    )&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FileName">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{0952B737-1BFA-4CFF-A5A7-0F63795187BA}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FilePath">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{386F0BDD-3FF7-4277-8AEF-A21D01C46A7A}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="LEFT(@[User::FileName],&#xA;FINDSTRING(@[User::FileName], &quot;_&quot;, 1) - 1)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FirstName">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{B6603E94-1F29-4569-863A-7CD7E77D5748}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="UPPER(&#xA;    LEFT(ISNULL(@[User::FirstName]) ? &quot;&quot; : @[User::FirstName], 1)&#xA;    +&#xA;    LEFT(ISNULL(@[User::LastName]) ? &quot;&quot; : @[User::LastName], 1)&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Initials">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{1EF85D40-98DB-4840-B251-484CA5471ABE}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="SUBSTRING(&#xA;@[User::FileName],&#xA;FINDSTRING(@[User::FileName], &quot;_&quot;, 1) + 1,&#xA;FINDSTRING(@[User::FileName], &quot;_&quot;, 2)&#xA;- FINDSTRING(@[User::FileName], &quot;_&quot;, 1) - 1&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="LastName">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{A017232A-B9E8-4A53-A778-022FD10EE4FF}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="SUBSTRING(&#xA;@[User::FileName],&#xA;FINDSTRING(@[User::FileName], &quot;_&quot;, 2) + 1,&#xA;FINDSTRING(@[User::FileName], &quot;_&quot;, 3)&#xA;- FINDSTRING(@[User::FileName], &quot;_&quot;, 2) - 1&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Month">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D76F0637-AA16-40A1-AB5D-CB3BB1DB9134}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="SUBSTRING(TRIM(@[User::Month]),1,3) + &quot;$&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Sheet">
      <DTS:VariableValue
        DTS:DataType="8">$</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{DB6EA79E-5DE6-42C7-948B-1E41BE317D1D}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="SUBSTRING(@[User::Month],1,3)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="ShortMonth">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
