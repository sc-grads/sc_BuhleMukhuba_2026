    <DTS:Executable
      DTS:refId="Package\Production Table Loading"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{978BA505-5F32-4174-B305-E52E4155469C}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Production Table Loading">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Production Table Loading\Execute SQL Task"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{CADF3DF4-2387-41ED-8C9A-5D73EBA6B782}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute SQL Task"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1541D4DB-23C4-4DC3-9CEB-40F1C7A44285}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;&#xA;DECLARE @PackageName VARCHAR(255) = 'Timesheet Migration';&#xA;DECLARE @ActorName VARCHAR(255) = SYSTEM_USER;&#xA;DECLARE @CurrentTable VARCHAR(255);&#xA;DECLARE @ErrorMessage VARCHAR(MAX);&#xA;&#xA;-- 1. EMPLOYEE&#xA;&#xA;BEGIN TRY&#xA;&#xA;    SET @CurrentTable = 'Employee';&#xA;&#xA;    DECLARE @EmployeeAudit TABLE (OperationType VARCHAR(20));&#xA;&#xA;    MERGE dbo.Employee AS tgt&#xA;    USING (&#xA;        SELECT DISTINCT&#xA;            FirstName,&#xA;            LastName&#xA;        FROM dbo.Stg_Timesheet&#xA;        WHERE FirstName IS NOT NULL&#xA;          AND LastName IS NOT NULL&#xA;    ) AS src&#xA;    ON tgt.FirstName = src.FirstName&#xA;    AND tgt.LastName = src.LastName&#xA;&#xA;    WHEN NOT MATCHED THEN&#xA;    INSERT (FirstName, LastName)&#xA;    VALUES (src.FirstName, src.LastName)&#xA;&#xA;    OUTPUT $action INTO @EmployeeAudit;&#xA;&#xA;    IF EXISTS (SELECT 1 FROM @EmployeeAudit)&#xA;    BEGIN&#xA;        INSERT INTO dbo.TblAudit&#xA;        (&#xA;            PackageName,&#xA;            TableName,&#xA;            OperationType,&#xA;            RowsModified,&#xA;            Status,&#xA;            StartTime,&#xA;            EndTime,&#xA;            ErrorMessage,&#xA;            ActorName&#xA;        )&#xA;        SELECT&#xA;            @PackageName,&#xA;            'Employee',&#xA;            OperationType,&#xA;            COUNT(*),&#xA;            'Success',&#xA;            GETDATE(),&#xA;            GETDATE(),&#xA;            'None',&#xA;            @ActorName&#xA;        FROM @EmployeeAudit&#xA;        GROUP BY OperationType;&#xA;    END&#xA;    ELSE&#xA;    BEGIN&#xA;        INSERT INTO dbo.TblAudit&#xA;        (&#xA;            PackageName,&#xA;            TableName,&#xA;            OperationType,&#xA;            RowsModified,&#xA;            Status,&#xA;            StartTime,&#xA;            EndTime,&#xA;            ErrorMessage,&#xA;            ActorName&#xA;        )&#xA;        VALUES&#xA;        (&#xA;            @PackageName,&#xA;            'Employee',&#xA;            'None',&#xA;            0,&#xA;            'No rows changed',&#xA;            GETDATE(),&#xA;            GETDATE(),&#xA;            'None',&#xA;            @ActorName&#xA;        );&#xA;    END;&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;&#xA;    SET @ErrorMessage = ERROR_MESSAGE();&#xA;&#xA;    INSERT INTO dbo.TblAudit&#xA;    (&#xA;        PackageName,&#xA;        TableName,&#xA;        OperationType,&#xA;        RowsModified,&#xA;        Status,&#xA;        StartTime,&#xA;        EndTime,&#xA;        ErrorMessage,&#xA;        ActorName&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        @PackageName,&#xA;        @CurrentTable,&#xA;        'Error',&#xA;        0,&#xA;        'Failed',&#xA;        GETDATE(),&#xA;        GETDATE(),&#xA;        @ErrorMessage,&#xA;        @ActorName&#xA;    );&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;&#xA;&#xA;-- 2. TIMESHEET&#xA;&#xA;BEGIN TRY&#xA;&#xA;    SET @CurrentTable = 'Timesheet';&#xA;&#xA;    DECLARE @TimesheetAudit TABLE (OperationType VARCHAR(20));&#xA;&#xA;    MERGE dbo.Timesheet AS tgt&#xA;    USING (&#xA;        SELECT&#xA;            e.EmployeeID,&#xA;            a.ActivityID,&#xA;            c.ClientID,&#xA;            s.WorkDate,&#xA;            CONVERT(VARCHAR(5), s.HoursWorked, 108) AS HoursWorked,&#xA;            CONVERT(VARCHAR(5), s.StartTime, 108) AS StartTime,&#xA;            CONVERT(VARCHAR(5), s.EndTime, 108) AS EndTime,&#xA;            s.Billing&#xA;        FROM dbo.Stg_Timesheet s&#xA;        INNER JOIN dbo.Employee e&#xA;            ON e.FirstName = s.FirstName&#xA;           AND e.LastName = s.LastName&#xA;        INNER JOIN dbo.Activity a&#xA;            ON a.ActivityName = s.ActivityName&#xA;        INNER JOIN dbo.Client c&#xA;            ON c.ClientName = s.ClientName&#xA;        LEFT JOIN dbo.LeaveType lt&#xA;            ON lt.LeaveType = s.ActivityName&#xA;        WHERE lt.LeaveTypeID IS NULL&#xA;          AND s.WorkDate IS NOT NULL&#xA;          AND s.StartTime IS NOT NULL&#xA;          AND s.EndTime IS NOT NULL&#xA;          AND s.HoursWorked IS NOT NULL&#xA;    ) AS src&#xA;    ON tgt.EmployeeID = src.EmployeeID&#xA;    AND tgt.WorkDate = src.WorkDate&#xA;    AND tgt.StartTime = src.StartTime&#xA;    AND tgt.EndTime = src.EndTime&#xA;&#xA;    WHEN MATCHED AND&#xA;    (&#xA;           tgt.ActivityID &lt;&gt; src.ActivityID&#xA;        OR tgt.ClientID &lt;&gt; src.ClientID&#xA;        OR tgt.HoursWorked &lt;&gt; src.HoursWorked&#xA;        OR tgt.Billing &lt;&gt; src.Billing&#xA;    )&#xA;    THEN UPDATE SET&#xA;        ActivityID = src.ActivityID,&#xA;        ClientID = src.ClientID,&#xA;        HoursWorked = src.HoursWorked,&#xA;        Billing = src.Billing,&#xA;        ModifiedDate = GETDATE()&#xA;&#xA;    WHEN NOT MATCHED THEN&#xA;    INSERT&#xA;    (&#xA;        EmployeeID,&#xA;        ActivityID,&#xA;        ClientID,&#xA;        WorkDate,&#xA;        HoursWorked,&#xA;        StartTime,&#xA;        EndTime,&#xA;        Billing&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        src.EmployeeID,&#xA;        src.ActivityID,&#xA;        src.ClientID,&#xA;        src.WorkDate,&#xA;        src.HoursWorked,&#xA;        src.StartTime,&#xA;        src.EndTime,&#xA;        src.Billing&#xA;    )&#xA;&#xA;    OUTPUT $action INTO @TimesheetAudit;&#xA;&#xA;    IF EXISTS (SELECT 1 FROM @TimesheetAudit)&#xA;    BEGIN&#xA;        INSERT INTO dbo.TblAudit&#xA;        (&#xA;            PackageName,&#xA;            TableName,&#xA;            OperationType,&#xA;            RowsModified,&#xA;            Status,&#xA;            StartTime,&#xA;            EndTime,&#xA;            ErrorMessage,&#xA;            ActorName&#xA;        )&#xA;        SELECT&#xA;            @PackageName,&#xA;            'Timesheet',&#xA;            OperationType,&#xA;            COUNT(*),&#xA;            'Success',&#xA;            GETDATE(),&#xA;            GETDATE(),&#xA;            'None',&#xA;            @ActorName&#xA;        FROM @TimesheetAudit&#xA;        GROUP BY OperationType;&#xA;    END&#xA;    ELSE&#xA;    BEGIN&#xA;        INSERT INTO dbo.TblAudit&#xA;        (&#xA;            PackageName,&#xA;            TableName,&#xA;            OperationType,&#xA;            RowsModified,&#xA;            Status,&#xA;            StartTime,&#xA;            EndTime,&#xA;            ErrorMessage,&#xA;            ActorName&#xA;        )&#xA;        VALUES&#xA;        (&#xA;            @PackageName,&#xA;            'Timesheet',&#xA;            'None',&#xA;            0,&#xA;            'No rows changed',&#xA;            GETDATE(),&#xA;            GETDATE(),&#xA;            'None',&#xA;            @ActorName&#xA;        );&#xA;    END;&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;&#xA;    SET @ErrorMessage = ERROR_MESSAGE();&#xA;&#xA;    INSERT INTO dbo.TblAudit&#xA;    (&#xA;        PackageName,&#xA;        TableName,&#xA;        OperationType,&#xA;        RowsModified,&#xA;        Status,&#xA;        StartTime,&#xA;        EndTime,&#xA;        ErrorMessage,&#xA;        ActorName&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        @PackageName,&#xA;        @CurrentTable,&#xA;        'Error',&#xA;        0,&#xA;        'Failed',&#xA;        GETDATE(),&#xA;        GETDATE(),&#xA;        @ErrorMessage,&#xA;        @ActorName&#xA;    );&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;&#xA;&#xA;-- 3. EMPLOYEE LEAVE&#xA;&#xA;BEGIN TRY&#xA;&#xA;    SET @CurrentTable = 'EmployeeLeave';&#xA;&#xA;    DECLARE @LeaveAudit TABLE (OperationType VARCHAR(20));&#xA;&#xA;    MERGE dbo.EmployeeLeave AS tgt&#xA;    USING (&#xA;        SELECT&#xA;            e.EmployeeID,&#xA;            lt.LeaveTypeID,&#xA;            s.WorkDate AS LeaveDate,&#xA;            CONVERT(VARCHAR(5), s.HoursWorked, 108) AS HoursTaken&#xA;        FROM dbo.Stg_Timesheet s&#xA;        INNER JOIN dbo.Employee e&#xA;            ON e.FirstName = s.FirstName&#xA;           AND e.LastName = s.LastName&#xA;        INNER JOIN dbo.LeaveType lt&#xA;            ON lt.LeaveType = s.ActivityName&#xA;        WHERE s.WorkDate IS NOT NULL&#xA;          AND s.HoursWorked IS NOT NULL&#xA;    ) AS src&#xA;    ON tgt.EmployeeID = src.EmployeeID&#xA;    AND tgt.LeaveTypeID = src.LeaveTypeID&#xA;    AND tgt.LeaveDate = src.LeaveDate&#xA;    AND tgt.HoursTaken = src.HoursTaken&#xA;&#xA;    WHEN NOT MATCHED THEN&#xA;    INSERT&#xA;    (&#xA;        EmployeeID,&#xA;        LeaveTypeID,&#xA;        LeaveDate,&#xA;        HoursTaken&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        src.EmployeeID,&#xA;        src.LeaveTypeID,&#xA;        src.LeaveDate,&#xA;        src.HoursTaken&#xA;    )&#xA;&#xA;    OUTPUT $action INTO @LeaveAudit;&#xA;&#xA;    IF EXISTS (SELECT 1 FROM @LeaveAudit)&#xA;    BEGIN&#xA;        INSERT INTO dbo.TblAudit&#xA;        (&#xA;            PackageName,&#xA;            TableName,&#xA;            OperationType,&#xA;            RowsModified,&#xA;            Status,&#xA;            StartTime,&#xA;            EndTime,&#xA;            ErrorMessage,&#xA;            ActorName&#xA;        )&#xA;        SELECT&#xA;            @PackageName,&#xA;            'EmployeeLeave',&#xA;            OperationType,&#xA;            COUNT(*),&#xA;            'Success',&#xA;            GETDATE(),&#xA;            GETDATE(),&#xA;            'None',&#xA;            @ActorName&#xA;        FROM @LeaveAudit&#xA;        GROUP BY OperationType;&#xA;    END&#xA;    ELSE&#xA;    BEGIN&#xA;        INSERT INTO dbo.TblAudit&#xA;        (&#xA;            PackageName,&#xA;            TableName,&#xA;            OperationType,&#xA;            RowsModified,&#xA;            Status,&#xA;            StartTime,&#xA;            EndTime,&#xA;            ErrorMessage,&#xA;            ActorName&#xA;        )&#xA;        VALUES&#xA;        (&#xA;            @PackageName,&#xA;            'EmployeeLeave',&#xA;            'None',&#xA;            0,&#xA;            'No rows changed',&#xA;            GETDATE(),&#xA;            GETDATE(),&#xA;            'None',&#xA;            @ActorName&#xA;        );&#xA;    END;&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;&#xA;    SET @ErrorMessage = ERROR_MESSAGE();&#xA;&#xA;    INSERT INTO dbo.TblAudit&#xA;    (&#xA;        PackageName,&#xA;        TableName,&#xA;        OperationType,&#xA;        RowsModified,&#xA;        Status,&#xA;        StartTime,&#xA;        EndTime,&#xA;        ErrorMessage,&#xA;        ActorName&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        @PackageName,&#xA;        @CurrentTable,&#xA;        'Error',&#xA;        0,&#xA;        'Failed',&#xA;        GETDATE(),&#xA;        GETDATE(),&#xA;        @ErrorMessage,&#xA;        @ActorName&#xA;    );&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
  </DTS:Executables>
