          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{53A541EC-5629-45CA-8663-405B698C8848}"
              SQLTask:SqlStatementSource="IF DB_ID('TimesheetDB') IS NULL&#xA;BEGIN&#xA;    CREATE DATABASE TimesheetDB;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Database &amp; Table Creation\Execute SQL Task"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B5109656-B394-4676-B946-050DDF234F9D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute SQL Task"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{53A541EC-5629-45CA-8663-405B698C8848}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;&#xA;--DROP AND RECREATE STAGING TABLE&#xA;IF OBJECT_ID('dbo.Stg_Timesheet', 'U') IS NOT NULL&#xA;BEGIN&#xA;    DROP TABLE dbo.Stg_Timesheet;&#xA;END;&#xA;&#xA;CREATE TABLE Stg_Timesheet (&#xA;    FirstName VARCHAR(50),&#xA;    LastName VARCHAR(50),&#xA;    ActivityName VARCHAR(100),&#xA;    ClientName VARCHAR(150),&#xA;    ClientProject VARCHAR(150),&#xA;    WorkDay VARCHAR(50),&#xA;    WorkDate DATE,&#xA;    HoursWorked TIME,&#xA;    StartTime TIME,&#xA;    EndTime TIME,&#xA;    Billing VARCHAR(50),&#xA;    SourceFileName VARCHAR(255)&#xA;);&#xA;&#xA;-- EMPLOYEE TABLE&#xA;IF OBJECT_ID('dbo.Employee', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE Employee (&#xA;        EmployeeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        FirstName VARCHAR(100) NOT NULL,&#xA;        LastName VARCHAR(100) NOT NULL,&#xA;        CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;        CONSTRAINT UQ_Employee_Name UNIQUE (FirstName, LastName)&#xA;    );&#xA;&#xA;    CREATE INDEX IX_Employee_Name&#xA;    ON Employee(FirstName, LastName);&#xA;END;&#xA;&#xA;&#xA;--ACTIVITY TABLE&#xA;IF OBJECT_ID('dbo.Activity', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE Activity (&#xA;        ActivityID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ActivityName VARCHAR(100) NOT NULL,&#xA;        CONSTRAINT UQ_ActivityName UNIQUE (ActivityName)&#xA;    );&#xA;&#xA;    CREATE INDEX IX_ActivityName&#xA;    ON Activity(ActivityName);&#xA;END;&#xA;&#xA;&#xA;--CLIENT TABLE&#xA;IF OBJECT_ID('dbo.Client', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE Client (&#xA;        ClientID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ClientName VARCHAR(150) NOT NULL,&#xA;        ClientProject VARCHAR(150),&#xA;        CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;        CONSTRAINT UQ_ClientName UNIQUE (ClientName)&#xA;    );&#xA;&#xA;    CREATE INDEX IX_ClientName&#xA;    ON Client(ClientName);&#xA;END;&#xA;&#xA;&#xA;--LEAVE TYPE TABLE&#xA;IF OBJECT_ID('dbo.LeaveType', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE LeaveType (&#xA;        LeaveTypeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        LeaveType VARCHAR(100) NOT NULL UNIQUE&#xA;    );&#xA;&#xA;    CREATE UNIQUE INDEX IX_LeaveType&#xA;    ON LeaveType(LeaveType);&#xA;END;&#xA;&#xA;&#xA;--TIMESHEET TABLE&#xA;IF OBJECT_ID('dbo.Timesheet', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE Timesheet (&#xA;        TimesheetID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL,&#xA;        ActivityID INT NOT NULL,&#xA;        ClientID INT NOT NULL,&#xA;        WorkDate DATE NOT NULL,&#xA;        HoursWorked NVARCHAR(5) NOT NULL,&#xA;        StartTime NVARCHAR(5) NOT NULL,&#xA;        EndTime NVARCHAR(5) NULL,&#xA;        Billing VARCHAR(50) NOT NULL,&#xA;        CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;        ModifiedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;&#xA;        CONSTRAINT FK_Timesheet_Employee&#xA;            FOREIGN KEY (EmployeeID) REFERENCES Employee(EmployeeID),&#xA;&#xA;        CONSTRAINT FK_Timesheet_Activity&#xA;            FOREIGN KEY (ActivityID) REFERENCES Activity(ActivityID),&#xA;&#xA;        CONSTRAINT FK_Timesheet_Client&#xA;            FOREIGN KEY (ClientID) REFERENCES Client(ClientID)&#xA;    );&#xA;&#xA;    CREATE INDEX IX_Timesheet_EmployeeID ON Timesheet(EmployeeID);&#xA;    CREATE INDEX IX_Timesheet_ActivityID ON Timesheet(ActivityID);&#xA;    CREATE INDEX IX_Timesheet_ClientID ON Timesheet(ClientID);&#xA;    CREATE INDEX IX_Timesheet_WorkDate ON Timesheet(WorkDate);&#xA;END;&#xA;&#xA;&#xA;--ADD MODIFIEDDATE &#xA;IF COL_LENGTH('dbo.Timesheet', 'ModifiedDate') IS NULL&#xA;BEGIN&#xA;    ALTER TABLE Timesheet&#xA;    ADD ModifiedDate DATETIME NOT NULL DEFAULT GETDATE();&#xA;END;&#xA;&#xA;&#xA;--TRIGGER TO UPDATE MODIFIED DATE &#xA;EXEC('&#xA;CREATE OR ALTER TRIGGER trg_Timesheet_ModifiedDate&#xA;ON dbo.Timesheet&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    UPDATE t&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.Timesheet t&#xA;    INNER JOIN inserted i&#xA;        ON t.TimesheetID = i.TimesheetID;&#xA;END;&#xA;');&#xA;&#xA;&#xA;--EMPLOYEE LEAVE TABLE&#xA;IF OBJECT_ID('dbo.EmployeeLeave', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE EmployeeLeave (&#xA;        LeaveID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL,&#xA;        LeaveTypeID INT NOT NULL,&#xA;        LeaveDate DATE NOT NULL,&#xA;        HoursTaken NVARCHAR(5) NOT NULL,&#xA;        SourceFileName VARCHAR(255) NULL,&#xA;        CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),&#xA;&#xA;        CONSTRAINT FK_EmployeeLeave_Employee&#xA;            FOREIGN KEY (EmployeeID) REFERENCES Employee(EmployeeID),&#xA;&#xA;        CONSTRAINT FK_EmployeeLeave_LeaveType&#xA;            FOREIGN KEY (LeaveTypeID) REFERENCES LeaveType(LeaveTypeID),&#xA;&#xA;        CONSTRAINT UQ_Leave UNIQUE (EmployeeID, LeaveDate)&#xA;    );&#xA;&#xA;    CREATE INDEX IX_EmployeeLeave_EmployeeID ON EmployeeLeave(EmployeeID);&#xA;    CREATE INDEX IX_EmployeeLeave_LeaveTypeID ON EmployeeLeave(LeaveTypeID);&#xA;    CREATE INDEX IX_EmployeeLeave_LeaveDate ON EmployeeLeave(LeaveDate);&#xA;    CREATE INDEX IX_EmployeeLeave_EmployeeDate ON EmployeeLeave(EmployeeID, LeaveDate);&#xA;    CREATE INDEX IX_EmployeeLeave_EmployeeLeaveType ON EmployeeLeave(EmployeeID, LeaveTypeID);&#xA;    CREATE INDEX IX_EmployeeLeave_SourceFile ON EmployeeLeave(SourceFileName);&#xA;END;&#xA;&#xA;--SSIS AUDIT TABLE&#xA;IF OBJECT_ID('dbo.SSISAudit', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE SSISAudit (&#xA;        AuditID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        PackageName VARCHAR(255) NOT NULL,&#xA;        FileName VARCHAR(255),&#xA;        OperationType VARCHAR(255),&#xA;        RowsModified INT,&#xA;        Status VARCHAR(50) NOT NULL,&#xA;        StartTime DATETIME NOT NULL DEFAULT GETDATE(),&#xA;        EndTime DATETIME NULL,&#xA;        ErrorMessage VARCHAR(MAX),&#xA;        ActorName VARCHAR(255) NULL&#xA;    );&#xA;&#xA;    CREATE INDEX IX_Audit_Status ON SSISAudit(Status);&#xA;    CREATE INDEX IX_Audit_File ON SSISAudit(FileName);&#xA;END;&#xA;&#xA;&#xA;--TABLE AUDIT&#xA;IF OBJECT_ID('dbo.TblAudit', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE TblAudit (&#xA;        AuditID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        PackageName VARCHAR(255) NOT NULL,&#xA;        TableName VARCHAR(255),&#xA;        OperationType VARCHAR(255),&#xA;        RowsModified INT,&#xA;        Status VARCHAR(50) NOT NULL,&#xA;        StartTime DATETIME NOT NULL DEFAULT GETDATE(),&#xA;        EndTime DATETIME NULL,&#xA;        ErrorMessage VARCHAR(MAX),&#xA;        ActorName VARCHAR(255) NULL&#xA;    );&#xA;&#xA;    CREATE INDEX IX_TblAudit_Status ON TblAudit(Status);&#xA;    CREATE INDEX IX_TblAudit_File ON TblAudit(TableName);&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM Activity)&#xA;BEGIN&#xA;    INSERT INTO Activity (ActivityName)&#xA;    VALUES&#xA;    ('.NET code'), ('Admin'), ('Analysis'), ('Architecture'), ('Training'),&#xA;    ('Configuration'), ('Cubes'), ('Database'), ('Demo'), ('Deployment'),&#xA;    ('Design'), ('Documentation'), ('Events'), ('ETL'), ('FrontEnd'),&#xA;    ('Installing'), ('Meeting'), ('Learning'), ('Lunch'), ('Other'),&#xA;    ('Presenting'), ('Project Management'), ('Research'),&#xA;    ('Sales call'), ('SharePoint'), ('Testing'), ('Travel'),&#xA;    ('Troubleshooting'), ('Waiting on client'),&#xA;    ('Website content'), ('Website and collateral'),&#xA;    ('Annual Leave'), ('Sick leave'),&#xA;    ('Study Leave'), ('Family Responsibility Leave'),&#xA;    ('Birthday leave'), ('Public Holiday'),&#xA;    ('Sick Leave - half day'),&#xA;    ('Annual Leave - half day');&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM Client)&#xA;BEGIN&#xA;    INSERT INTO Client (ClientName)&#xA;    VALUES&#xA;    ('Internal Sambe'), ('ADVTech'), ('AFA Sasfin'),&#xA;    ('Artist Proof Studio'), ('Assimil8'), ('Base 3'),&#xA;    ('Blue Legacy'), ('C. Steinweg'),&#xA;    ('Conekt – Aurum'), ('Conekt – Clientele'),&#xA;    ('Conekt – Internal Meeting'), ('Conekt – Meridian'),&#xA;    ('Conekt – Winning Business'), ('Conekt AGSA SharePoint'),&#xA;    ('Dentons'), ('Discovery'),  ('Discovery Bank'), ('Discovery CRES'),&#xA;    ('Discovery CSI'), ('Discovery Health'),&#xA;    ('Discovery Information Governance and Security'),&#xA;    ('Discovery Innovation Lab'), ('Discovery People'), ('Discovery Skills'),&#xA;    ('Discovery Vitality'), ('Gyro'), ('KFC Digistics'), ('Life Healthcare'),&#xA;    ('Medi-Charge'), ('MICA Build'), ('Michelin'), ('Mistro Foods'),&#xA;    ('OK Furnitures'), ('Olympic Paints'), ('RMB'),&#xA;    ('RMB CM Data Warehouse support'), ('RMB CORE NRTI'),&#xA;    ('RMB Tumelo'), ('Sachar Mobile'), ('Sanlam'),('SBV'),&#xA;    ('Sibanya'), ('Transport Holdings');&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM LeaveType)&#xA;BEGIN&#xA;    INSERT INTO LeaveType (LeaveType)&#xA;    VALUES&#xA;    ('Annual Leave'),&#xA;    ('Sick leave'),&#xA;    ('Study Leave'),&#xA;    ('Family Responsibility Leave'),&#xA;    ('Birthday leave'),&#xA;    ('Public Holiday'),&#xA;    ('Sick Leave - half day'),&#xA;    ('Annual Leave - half day');&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
